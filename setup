#!/bin/sh
# brain.md setup — link the `brain` skill into Pi and wire its global AGENTS.md.
# From a checkout: ./setup        (same as: node skills/brain/bin/brain.mjs setup)
set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
exec node "$SCRIPT_DIR/skills/brain/bin/brain.mjs" setup "$@"
