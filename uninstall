#!/bin/sh
# brain.md uninstall — remove the skill link and the wired AGENTS.md block.
# From a checkout: ./uninstall    (same as: node skills/brain/bin/brain.mjs uninstall)
set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
exec node "$SCRIPT_DIR/skills/brain/bin/brain.mjs" uninstall "$@"
